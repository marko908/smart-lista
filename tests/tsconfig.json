{
  "compilerOptions": {
    "module": "node16",
    "target": "es2020",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "..",
    "outDir": "../.test-build"
  },
  "include": ["**/*.ts", "../src/data/**/*.ts", "../src/lib/**/*.ts"]
}
